pkgname=pomopixel
pkgver=1.0.0
pkgrel=1
pkgdesc='Retro pixel art Pomodoro timer following Omarchy theme'
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-quickcontrols2' 'qt6-wayland' 'pipewire')
makedepends=('gcc' 'make' 'qt6-base')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/pomopixel "$pkgdir/usr/bin/pomopixel"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/pomopixel.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/pomopixel.svg"
  install -Dm644 "$startdir/pomopixel.desktop" "$pkgdir/usr/share/applications/pomopixel.desktop"

  # Install default sound assets
  install -d "$pkgdir/usr/share/pomopixel/sounds"
  install -m644 assets/*.wav "$pkgdir/usr/share/pomopixel/sounds/"
}
